{
  "name": "slot-chan",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:review": "tsc -b && vite build --mode review --outDir review-dist",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check:server-runtime": "tsc -p tsconfig.server.json && node scripts/check-server-runtime.mjs",
    "lint": "eslint .",
    "analyze:balance": "node --experimental-strip-types scripts/analyze-balance.mjs"
  },
  "dependencies": {
    "eld": "^2.1.0",
    "express": "^5.1.0",
    "livekit-client": "^2.15.5",
    "three": "^0.180.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  }
}
